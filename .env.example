# コピーして .env を作成して使用する（.env はコミットしない）
# cp .env.example .env

# --- Django ---
# 署名（JWT）にも使う。32文字以上のランダムな値にする（例: python -c "import secrets; print(secrets.token_urlsafe(48))"）
DJANGO_SECRET_KEY=dev-only-secret-key-change-me-in-production-0123456789
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- MySQL ---
MYSQL_DATABASE=hr_policy
MYSQL_USER=hr_policy
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_HOST=db
MYSQL_PORT=3306
# ホストから接続する際のポート（ホストのMySQLと競合しないよう既定は3307）
DB_HOST_PORT=3307

# --- AI（フェーズ0: Gemini） ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# gemini / fake（fake はAIを呼ばず固定の回答を返す）
RAG_BACKEND=gemini

# --- レート制限（省略すると、ここに書いた値が使われる） ---
# AI全体の上限は、Gemini無料枠（15回/分・500回/日）に余裕を持たせた値にする
# THROTTLE_LOGIN_IP=10/min
# THROTTLE_CHAT_USER_MINUTE=10/min
# THROTTLE_CHAT_USER_DAY=200/day
# THROTTLE_AI_GLOBAL_MINUTE=12/min
# THROTTLE_AI_GLOBAL_DAY=450/day
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_SECONDS=900
# --- 規程のアップロード（省略すると、ここに書いた値が使われる） ---
# POLICY_MAX_UPLOAD_MB=20
# POLICY_MAX_PAGES=500
# 質問のたびに規程の全文をAIへ送るため、長すぎると、AIの利用枠（トークン数/分）を超える
# POLICY_MAX_TEXT_CHARS=200000
# POLICY_STALE_MINUTES=10
# THROTTLE_POLICY_UPLOAD=10/hour
# 前段のプロキシの段数（公開時に、Caddyなどを前に置く場合は 1）。0 のときは X-Forwarded-For を信用しない
# TRUSTED_PROXY_COUNT=0

# --- デモ用ユーザー（make seed で作成。ローカル確認用。公開時は変更する） ---
DEMO_PASSWORD=demo-password
