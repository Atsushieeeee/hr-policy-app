# コピーして .env を作成して使用する（.env はコミットしない）
# cp .env.example .env

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- MySQL ---
MYSQL_DATABASE=hr_policy
MYSQL_USER=hr_policy
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_HOST=db
MYSQL_PORT=3306
# ホストから接続する際のポート（ホストのMySQLと競合しないよう既定は3307）
DB_HOST_PORT=3307

# --- AI（フェーズ0: Gemini） ---
GEMINI_API_KEY=
